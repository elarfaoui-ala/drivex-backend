# ── Railway Deployment ─────────────────────────────────────────
# Railway auto-provisions PostgreSQL — it will set DATABASE_URL
# for you. Set the rest in Railway Dashboard → Variables.

# ── Profile ───────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Database (PostgreSQL) — Railway provides DATABASE_URL ──────
DATABASE_URL=jdbc:postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_USERNAME=
DATABASE_PASSWORD=

# ── Redis (Upstash) ──────────────────────────────────────────
REDIS_HOST=your-upstash-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-upstash-password
REDIS_SSL=true

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=generate-a-random-256-bit-base64-string-here

# ── Server ───────────────────────────────────────────────────
PORT=8080

# ── Optional ─────────────────────────────────────────────────
# DDL_AUTO=update
# SHOW_SQL=false
# LOG_LEVEL_APP=INFO
# LOG_LEVEL_SQL=INFO
